#!/usr/bin/env bash

set -euo pipefail

. "$(dirname "$0")/lib/real_tool.sh"

command=""
subcommand=""
endpoint=""
method=""
sends_fields=false
reads_query_from_file=false
api_positionals=0
api_flag_awaiting_value=""

deny() {
  echo "gh: create, edit, and merge pull requests with the GitHub MCP tools." \
    "If they cannot do it, run gh with ALLOW_GH_PULL_REQUEST_WRITE=1." >&2
  exit 1
}

find_command() {
  local word value_expected=false
  for word in "$@"; do
    if $value_expected; then
      value_expected=false
    elif [ -z "$word" ]; then
      continue
    elif [ "$word" = -- ]; then
      return
    elif [[ $word == --*=* ]]; then
      continue
    elif [[ $word == --* || $word == -? ]]; then
      value_expected=true
    elif [[ $word != -* ]] && [ -z "$command" ]; then
      command=$word
    elif [[ $word != -* ]]; then
      subcommand=$word
      return
    fi
  done
}

api_long_flag_takes_value() {
  case $1 in
    --cache | --field | --header | --hostname | --input | --jq | --method | --preview | --raw-field | --template) return 0 ;;
  esac
  return 1
}

api_short_flag_takes_value() {
  case $1 in
    X | f | F | H | q | t | p) return 0 ;;
  esac
  return 1
}

record_api_flag() {
  local flag=$1 value=$2
  case $flag in
    -X | --method) method=$value ;;
    -f | --raw-field) sends_fields=true ;;
    -F | --field)
      sends_fields=true
      [[ $value == query=@* ]] && reads_query_from_file=true
      ;;
    --input)
      sends_fields=true
      reads_query_from_file=true
      ;;
  esac
  return 0
}

record_api_positional() {
  api_positionals=$((api_positionals + 1))
  [ "$api_positionals" -eq 2 ] && endpoint=$1
  return 0
}

record_api_short_flags() {
  local letters=${1#-} letter
  while [ -n "$letters" ]; do
    letter=${letters:0:1}
    letters=${letters:1}
    if [[ $letters == =* ]]; then
      record_api_flag "-$letter" "${letters:1}"
      return
    fi
    if api_short_flag_takes_value "$letter"; then
      if [ -n "$letters" ]; then
        record_api_flag "-$letter" "$letters"
      else
        api_flag_awaiting_value="-$letter"
      fi
      return
    fi
  done
}

record_api_word() {
  local word=$1
  if [[ $word == --*=* ]]; then
    record_api_flag "${word%%=*}" "${word#*=}"
  elif [[ $word == --* ]]; then
    api_long_flag_takes_value "$word" && api_flag_awaiting_value=$word
  elif [[ $word == -?* ]]; then
    record_api_short_flags "$word"
  else
    record_api_positional "$word"
  fi
  return 0
}

parse_api_arguments() {
  local word options_ended=false
  for word in "$@"; do
    if [ -n "$api_flag_awaiting_value" ]; then
      record_api_flag "$api_flag_awaiting_value" "$word"
      api_flag_awaiting_value=""
    elif $options_ended; then
      record_api_positional "$word"
    elif [ "$word" = -- ]; then
      options_ended=true
    else
      record_api_word "$word"
    fi
  done
}

http_method() {
  if [ -n "$method" ]; then
    printf '%s\n' "$method" | tr '[:lower:]' '[:upper:]'
  elif $sends_fields; then
    echo POST
  else
    echo GET
  fi
}

writes_a_pull_request() {
  [ "$command" = pr ] || return 1
  case $subcommand in
    create | new | edit | merge) return 0 ;;
  esac
  return 1
}

runs_a_pull_request_mutation() {
  [[ $endpoint == graphql || $endpoint == */graphql ]] || return 1
  $reads_query_from_file && return 0
  [[ $* =~ (create|update|merge|enqueue)PullRequest|enablePullRequestAutoMerge ]]
}

api_writes_pull_requests() {
  local http
  [ "$command" = api ] || return 1
  parse_api_arguments "$@"
  runs_a_pull_request_mutation "$@" && return 0
  [[ $endpoint == */pulls* ]] || return 1
  http=$(http_method)
  [[ $http == POST || $http == PUT || $http == PATCH ]]
}

gh=$(real_tool gh)

if [ -z "${ALLOW_GH_PULL_REQUEST_WRITE-}" ]; then
  find_command "$@"
  writes_a_pull_request && deny
  api_writes_pull_requests "$@" && deny
fi

exec "$gh" "$@"
