#!/usr/bin/env bash

set -euo pipefail

. "$(dirname "$0")/lib/real_tool.sh"

readonly PULL_REQUEST_WRITES='
create_pull_request                cli      pr create
create_pull_request                cli      pr new
create_pull_request                rest     POST pulls
create_pull_request                graphql  createPullRequest
update_pull_request                cli      pr edit --title
update_pull_request                cli      pr edit -t
update_pull_request                cli      pr edit --body
update_pull_request                cli      pr edit -b
update_pull_request                cli      pr edit --body-file
update_pull_request                cli      pr edit -F
update_pull_request                cli      pr edit --base
update_pull_request                cli      pr edit -B
update_pull_request                cli      pr edit --add-reviewer
update_pull_request                cli      pr ready
update_pull_request                cli      pr close
update_pull_request                cli      pr reopen
update_pull_request                rest     PATCH pulls/*
update_pull_request                rest     POST pulls/*/requested_reviewers
update_pull_request                rest     POST pulls/*/ccr/ready_for_review
update_pull_request                rest     POST pulls/*/ccr/convert_to_draft
update_pull_request                graphql  updatePullRequest
update_pull_request                graphql  closePullRequest
update_pull_request                graphql  reopenPullRequest
update_pull_request                graphql  markPullRequestReadyForReview
update_pull_request                graphql  convertPullRequestToDraft
update_pull_request                graphql  requestReviews
update_pull_request                graphql  requestReviewsByLogin
enable_pr_auto_merge               cli      pr merge --auto
enable_pr_auto_merge               rest     PUT pulls/*/ccr/auto_merge
enable_pr_auto_merge               graphql  enablePullRequestAutoMerge
disable_pr_auto_merge              cli      pr merge --disable-auto
disable_pr_auto_merge              rest     DELETE pulls/*/ccr/auto_merge
disable_pr_auto_merge              graphql  disablePullRequestAutoMerge
merge_pull_request                 cli      pr merge
merge_pull_request                 rest     PUT pulls/*/merge
merge_pull_request                 graphql  mergePullRequest
update_pull_request_branch         cli      pr update-branch !--rebase
update_pull_request_branch         rest     PUT pulls/*/update-branch
update_pull_request_branch         graphql  updatePullRequestBranch !REBASE
pull_request_review_write          cli      pr review
pull_request_review_write          rest     POST pulls/*/reviews
pull_request_review_write          rest     POST pulls/*/reviews/*/events
pull_request_review_write          rest     DELETE pulls/*/reviews/*
pull_request_review_write          graphql  addPullRequestReview
pull_request_review_write          graphql  submitPullRequestReview
pull_request_review_write          graphql  deletePullRequestReview
add_reply_to_pull_request_comment  rest     POST pulls/*/comments in_reply_to
add_reply_to_pull_request_comment  rest     POST pulls/*/comments/*/replies
add_reply_to_pull_request_comment  rest     POST pulls/comments/*/reactions
add_reply_to_pull_request_comment  graphql  addPullRequestReviewComment inReplyTo
add_reply_to_pull_request_comment  graphql  addPullRequestReviewThreadReply
add_comment_to_pending_review      rest     POST pulls/*/comments
add_comment_to_pending_review      graphql  addPullRequestReviewComment
add_comment_to_pending_review      graphql  addPullRequestReviewThread
resolve_review_thread              rest     POST pulls/*/ccr/comments/*/resolve
resolve_review_thread              graphql  resolveReviewThread
unresolve_review_thread            rest     POST pulls/*/ccr/comments/*/unresolve
unresolve_review_thread            graphql  unresolveReviewThread
add_issue_comment                  cli      pr comment --create-if-none
add_issue_comment                  cli      pr comment !--edit-last !--delete-last
'

arguments=()
command=""
subcommand=""
endpoint=""
method=""
sends_fields=false
api_positionals=0
api_flag_awaiting_value=""
field_names=()
fields_text=""
query_field=""
reads_query_from_file=false
api_method=""
repository_resource=""
graphql_query=""

deny() {
  local tool=$1
  echo "gh: use the GitHub MCP tool $tool for this." \
    "The agent that opened a pull request, or its parent, manages it." \
    "If you lack $tool, ask your parent agent to do it." \
    "Run gh with ALLOW_GH_PULL_REQUEST_WRITE=1 only when the user asks." >&2
  exit 1
}

deny_unchecked_query() {
  echo "gh: pass the GraphQL query inline with -f query=..., not from a file" \
    "or standard input, so gh can check it for pull request writes." \
    "Run gh with ALLOW_GH_PULL_REQUEST_WRITE=1 only when the user asks." >&2
  exit 1
}

find_command() {
  local word value_expected=false
  for word in "$@"; do
    if $value_expected; then
      value_expected=false
    elif [ -z "$word" ]; then
      continue
    elif [ "$word" = -- ]; then
      return
    elif [[ $word == --*=* ]]; then
      continue
    elif [[ $word == --* || $word == -? ]]; then
      value_expected=true
    elif [[ $word != -* ]] && [ -z "$command" ]; then
      command=$word
    elif [[ $word != -* ]]; then
      subcommand=$word
      return
    fi
  done
}

api_long_flag_takes_value() {
  case $1 in
    --cache | --field | --header | --hostname | --input | --jq | --method | --preview | --raw-field | --template) return 0 ;;
  esac
  return 1
}

api_short_flag_takes_value() {
  case $1 in
    X | f | F | H | q | t | p) return 0 ;;
  esac
  return 1
}

record_field() {
  local field=$1 name=${1%%=*}
  sends_fields=true
  field_names+=("${name%%\[*}")
  fields_text+=$'\n'$field
  [[ $field == query=* ]] && query_field=${field#query=}
  return 0
}

record_api_flag() {
  local flag=$1 value=$2
  case $flag in
    -X | --method) method=$value ;;
    -f | --raw-field) record_field "$value" ;;
    -F | --field)
      record_field "$value"
      [[ $value == query=@* ]] && reads_query_from_file=true
      ;;
    --input)
      sends_fields=true
      reads_query_from_file=true
      ;;
  esac
  return 0
}

record_api_positional() {
  api_positionals=$((api_positionals + 1))
  [ "$api_positionals" -eq 2 ] && endpoint=$1
  return 0
}

record_api_short_flags() {
  local letters=${1#-} letter
  while [ -n "$letters" ]; do
    letter=${letters:0:1}
    letters=${letters:1}
    if [[ $letters == =* ]]; then
      record_api_flag "-$letter" "${letters:1}"
      return
    fi
    if api_short_flag_takes_value "$letter"; then
      if [ -n "$letters" ]; then
        record_api_flag "-$letter" "$letters"
      else
        api_flag_awaiting_value="-$letter"
      fi
      return
    fi
  done
}

record_api_word() {
  local word=$1
  if [[ $word == --*=* ]]; then
    record_api_flag "${word%%=*}" "${word#*=}"
  elif [[ $word == --* ]]; then
    api_long_flag_takes_value "$word" && api_flag_awaiting_value=$word
  elif [[ $word == -?* ]]; then
    record_api_short_flags "$word"
  else
    record_api_positional "$word"
  fi
  return 0
}

parse_api_arguments() {
  local word options_ended=false
  for word in "$@"; do
    if [ -n "$api_flag_awaiting_value" ]; then
      record_api_flag "$api_flag_awaiting_value" "$word"
      api_flag_awaiting_value=""
    elif $options_ended; then
      record_api_positional "$word"
    elif [ "$word" = -- ]; then
      options_ended=true
    else
      record_api_word "$word"
    fi
  done
}

http_method() {
  if [ -n "$method" ]; then
    printf '%s\n' "$method" | tr '[:lower:]' '[:upper:]'
  elif $sends_fields; then
    echo POST
  else
    echo GET
  fi
}

describe_api_request() {
  local path
  parse_api_arguments "$@"
  api_method=$(http_method)
  path=${endpoint%%[?#]*}
  path=${path%/}
  if [[ $path == graphql || $path == */graphql ]]; then
    if $reads_query_from_file; then
      deny_unchecked_query
    fi
    graphql_query=$query_field
  elif [[ $path =~ (^|/)(repos/[^/]+/[^/]+|repositories/[0-9]+)/(.+)$ ]]; then
    repository_resource=${BASH_REMATCH[3]}
  fi
}

names_flag() {
  local word=$1 flag=$2
  case $flag in
    --*) [[ $word == "$flag" || $word == "$flag="* ]] ;;
    *) [[ $word == "$flag"* ]] ;;
  esac
}

has_flag() {
  local word
  for word in "${arguments[@]}"; do
    [ "$word" != -- ] || return 1
    names_flag "$word" "$1" && return 0
  done
  return 1
}

sends_field() {
  local name
  for name in "${field_names[@]}"; do
    [ "$name" = "$1" ] && return 0
  done
  return 1
}

mentions() {
  local word=$1 text=$2
  local word_alone="(^|[^_A-Za-z0-9])$word([^_A-Za-z0-9]|$)"
  [[ $text =~ $word_alone ]]
}

fields_mention() {
  mentions "$1" "$fields_text"
}

meets_conditions() {
  local test=$1 condition
  shift
  for condition in "$@"; do
    if [[ $condition == '!'* ]]; then
      "$test" "${condition#!}" && return 1
    else
      "$test" "$condition" || return 1
    fi
  done
  return 0
}

matches_cli_form() {
  local -a words
  read -ra words <<< "$1"
  [ "$command $subcommand" = "${words[0]} ${words[1]}" ] || return 1
  meets_conditions has_flag "${words[@]:2}"
}

matches_rest_form() {
  local -a words
  read -ra words <<< "$1"
  [ "$api_method" = "${words[0]}" ] || return 1
  [[ $repository_resource =~ ^${words[1]//\*/[^/]+}$ ]] || return 1
  meets_conditions sends_field "${words[@]:2}"
}

matches_graphql_form() {
  local -a words
  read -ra words <<< "$1"
  mentions "${words[0]}" "$graphql_query" || return 1
  meets_conditions fields_mention "${words[@]:1}"
}

matches_form() {
  local interface=$1 form=$2
  case $interface in
    cli) matches_cli_form "$form" ;;
    rest) matches_rest_form "$form" ;;
    graphql) matches_graphql_form "$form" ;;
    *) return 1 ;;
  esac
}

pull_request_write_tool() {
  local tool interface form
  while read -r tool interface form; do
    if matches_form "$interface" "$form"; then
      printf '%s\n' "$tool"
      return 0
    fi
  done <<< "$PULL_REQUEST_WRITES"
  return 1
}

guards_pull_request_writes() {
  [ "${CLAUDE_CODE_REMOTE-}" = true ] && [ -z "${ALLOW_GH_PULL_REQUEST_WRITE-}" ]
}

gh=$(real_tool gh)

if guards_pull_request_writes; then
  arguments=("$@")
  find_command "$@"
  if [ "$command" = api ]; then
    describe_api_request "$@"
  fi
  if tool=$(pull_request_write_tool); then
    deny "$tool"
  fi
fi

exec_real_tool gh "$gh" "$@"
