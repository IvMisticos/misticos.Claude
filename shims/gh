#!/usr/bin/env bash

set -euo pipefail

shim_dir=$(dirname "$0")
. "$shim_dir/lib/real_tool.sh"

guards_pull_request_writes() {
  [ "${CLAUDE_CODE_REMOTE-}" = true ] && [ -z "${ALLOW_GH_PULL_REQUEST_WRITE-}" ]
}

gh=$(real_tool gh)

if guards_pull_request_writes; then
  . "$shim_dir/lib/hook_python.sh"
  find_hook_python
  "$python" "$shim_dir/../hooks/pull_request_writes.py" "$@"
fi

exec_real_tool gh "$gh" "$@"
