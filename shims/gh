#!/usr/bin/env bash

set -euo pipefail

. "$(dirname "$0")/lib/real_tool.sh"

deny() {
  echo "gh: create, edit, and merge pull requests with the GitHub MCP tools." \
    "If they cannot do it, run gh with ALLOW_GH_PULL_REQUEST_WRITE=1." >&2
  exit 1
}

takes_no_value() {
  case $1 in
    -h | --help | -i | --include | --paginate | --silent | --slurp | --verbose) return 0 ;;
  esac
  return 1
}

command_path() {
  local word value_expected=false found=0
  for word in "$@"; do
    if $value_expected; then
      value_expected=false
    elif [[ $word == --*=* ]] || takes_no_value "$word"; then
      continue
    elif [[ $word == --* || $word == -? ]]; then
      value_expected=true
    elif [[ $word != -* ]]; then
      printf '%s\n' "$word"
      found=$((found + 1))
      [ "$found" -lt 2 ] || return 0
    fi
  done
}

writes_a_pull_request() {
  [ "${1-}" = pr ] || return 1
  case ${2-} in
    create | new | edit | merge) return 0 ;;
  esac
  return 1
}

names_pull_requests() {
  [[ $1 == */pulls* ]]
}

runs_a_pull_request_mutation() {
  local word
  [[ $* =~ (create|merge|enqueue)PullRequest|enablePullRequestAutoMerge ]] || return 1
  for word in "$@"; do
    [[ $word == graphql || $word == */graphql ]] && return 0
  done
  return 1
}

api_method() {
  local method="" fields_given=false
  while [ $# -gt 0 ]; do
    case $1 in
      -X | --method) method=${2-} ;;
      --method=*) method=${1#--method=} ;;
      -X?*) method=${1#-X} ;;
      -f* | -F* | --field | --raw-field | --input | --field=* | --raw-field=* | --input=*) fields_given=true ;;
    esac
    shift
  done
  if [ -n "$method" ]; then
    printf '%s\n' "$method" | tr '[:lower:]' '[:upper:]'
  elif $fields_given; then
    echo POST
  else
    echo GET
  fi
}

api_writes_pull_requests() {
  local endpoint=$1 method
  shift
  runs_a_pull_request_mutation "$@" && return 0
  names_pull_requests "$endpoint" || return 1
  method=$(api_method "$@")
  [[ $method == POST || $method == PUT || $method == PATCH ]]
}

gh=$(real_tool gh)

if [ -z "${ALLOW_GH_PULL_REQUEST_WRITE-}" ]; then
  mapfile -t command < <(command_path "$@")
  writes_a_pull_request "${command[@]}" && deny
  [ "${command[0]-}" = api ] && api_writes_pull_requests "${command[1]-}" "$@" && deny
fi

exec "$gh" "$@"
