#!/usr/bin/env bash

set -euo pipefail

. "$(dirname "$0")/lib/real_tool.sh"

location_options=()
subcommand=""
subcommand_arguments=()
global_options_change_identity=false

deny() {
  echo "git: keep the git identity the harness set. Read it with git config --get." \
    "If a change is genuinely needed, run git with ALLOW_GIT_IDENTITY_CHANGE=1." >&2
  exit 1
}

equals_ignoring_case() (
  shopt -s nocasematch
  [[ $1 == "$2" ]]
)

contains_ignoring_case() (
  shopt -s nocasematch
  [[ $1 == *"$2"* ]]
)

is_identity_key() {
  equals_ignoring_case "$1" user.name || equals_ignoring_case "$1" user.email
}

environment_identity() {
  printf '%s|%s|%s|%s' "${GIT_AUTHOR_NAME-}" "${GIT_AUTHOR_EMAIL-}" \
    "${GIT_COMMITTER_NAME-}" "${GIT_COMMITTER_EMAIL-}"
}

environment_sets_identity() {
  [ -n "${GIT_AUTHOR_NAME-}${GIT_AUTHOR_EMAIL-}${GIT_COMMITTER_NAME-}${GIT_COMMITTER_EMAIL-}" ]
}

environment_identity_differs_from_harness() {
  [ -n "${HARNESS_GIT_IDENTITY+set}" ] || { environment_sets_identity; return; }
  [ "$(environment_identity)" != "$HARNESS_GIT_IDENTITY" ]
}

environment_changes_identity() {
  local index name
  environment_identity_differs_from_harness && return 0
  contains_ignoring_case "${GIT_CONFIG_PARAMETERS-}" "'user.name=" && return 0
  contains_ignoring_case "${GIT_CONFIG_PARAMETERS-}" "'user.email=" && return 0
  for ((index = 0; index < ${GIT_CONFIG_COUNT:-0}; index++)); do
    name="GIT_CONFIG_KEY_$index"
    is_identity_key "${!name-}" && return 0
  done
  return 1
}

config_reads() {
  local word
  [[ ${1-} == get || ${1-} == list ]] && return 0
  for word in "$@"; do
    case $word in
      --get | --get-all | --get-regexp | --get-urlmatch | --list | -l) return 0 ;;
    esac
  done
  return 1
}

config_writes_globally() {
  local word
  for word in "$@"; do
    case $word in
      --global | --system) return 0 ;;
    esac
  done
  return 1
}

config_changes_user_section() {
  local word changes_a_section=false names_user=false
  for word in "$@"; do
    case $word in
      --remove-section | --rename-section | remove-section | rename-section) changes_a_section=true ;;
    esac
    if equals_ignoring_case "$word" user; then names_user=true; fi
  done
  $changes_a_section && $names_user
}

config_unsets_identity_key() {
  local word unsets=false names_key=false
  for word in "$@"; do
    case $word in
      --unset | --unset-all | unset) unsets=true ;;
    esac
    is_identity_key "$word" && names_key=true
  done
  $unsets && $names_key
}

config_sets_identity_key() {
  local word key_seen=false skip_next=false
  for word in "$@"; do
    if $skip_next; then
      skip_next=false
    elif is_identity_key "$word"; then
      key_seen=true
    else
      case $word in
        --type | --default | --file | -f | --blob | --comment | --value) skip_next=true ;;
        -*) ;;
        *) $key_seen && return 0 ;;
      esac
    fi
  done
  return 1
}

config_changes_identity() {
  config_reads "$@" && return 1
  config_changes_user_section "$@" || config_unsets_identity_key "$@" || config_sets_identity_key "$@"
}

config_changes_global_identity() {
  config_changes_identity "$@" && config_writes_globally "$@"
}

commit_changes_author() {
  local word
  for word in "$@"; do
    [[ $word == --author || $word == --author=* ]] && return 0
  done
  return 1
}

read_global_options() {
  local word
  while [ $# -gt 0 ]; do
    word=$1
    shift
    case $word in
      -c | --config-env)
        word=${1-}
        if is_identity_key "${word%%=*}"; then global_options_change_identity=true; fi
        shift
        ;;
      --config-env=*)
        word=${word#--config-env=}
        if is_identity_key "${word%%=*}"; then global_options_change_identity=true; fi
        ;;
      -C | --git-dir | --work-tree)
        location_options+=("$word" "${1-}")
        shift
        ;;
      --git-dir=* | --work-tree=*) location_options+=("$word") ;;
      --namespace) shift ;;
      -*) ;;
      *)
        subcommand=$word
        subcommand_arguments=("$@")
        return
        ;;
    esac
  done
}

subcommand_changes_identity() {
  case $subcommand in
    config) config_changes_identity ${subcommand_arguments[@]+"${subcommand_arguments[@]}"} ;;
    commit) commit_changes_author ${subcommand_arguments[@]+"${subcommand_arguments[@]}"} ;;
    *) return 1 ;;
  esac
}

subcommand_changes_global_identity() {
  [[ $subcommand == config ]] && config_changes_global_identity ${subcommand_arguments[@]+"${subcommand_arguments[@]}"}
}

arguments_change_identity() {
  $global_options_change_identity || subcommand_changes_identity
}

creates_a_repository() {
  [[ $subcommand == init || $subcommand == clone ]]
}

repository_directory() {
  local directory
  directory=$("$git" "$@" rev-parse --path-format=absolute --git-common-dir 2>/dev/null) || return 1
  [ -n "$directory" ] && cd "$directory" 2>/dev/null && pwd -P
}

targets_project_repository() {
  local target project
  [ -n "${HARNESS_PROJECT_DIR-}" ] || return 1
  target=$(repository_directory ${location_options[@]+"${location_options[@]}"}) || return 1
  project=$(
    unset GIT_DIR GIT_WORK_TREE GIT_COMMON_DIR
    repository_directory -C "$HARNESS_PROJECT_DIR"
  ) || return 1
  [ "$target" = "$project" ]
}

git=$(real_tool git)

if [ -z "${ALLOW_GIT_IDENTITY_CHANGE-}" ]; then
  read_global_options "$@"
  subcommand_changes_global_identity && deny
  identity_changes=false
  creates_a_repository || ! environment_changes_identity || identity_changes=true
  arguments_change_identity && identity_changes=true
  if $identity_changes; then
    targets_project_repository && deny
  fi
fi

exec "$git" "$@"
