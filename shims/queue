#!/usr/bin/env bash

set -euo pipefail

bin_dir=$(cd "$(dirname "$0")" && pwd -P)
. "$bin_dir/lib/real_tool.sh"
. "$bin_dir/lib/hook_python.sh"
REAL_TOOL_PATH=$(tool_search_path)

mise_tool_providing() {
  case $1 in
    bun | bunx) echo bun ;;
    cargo) echo rust ;;
    dotnet) echo dotnet ;;
    uv | uvx) echo uv ;;
    *) return 1 ;;
  esac
}

run_tool_through_mise() {
  local name=$1 provider mise env path
  provider=$(mise_tool_providing "$name") || return 1
  mise=$(find_mise) || return 1
  env=$(real_tool env)
  path=$(plugin_free_path)
  tool_command=("$env" "PATH=$path" "$mise" --quiet x "$provider" -- "$name")
}

find_tool_command() {
  local name=$1 tool
  if tool=$(real_tool "$name" 2>/dev/null); then
    tool_command=("$tool")
  elif ! run_tool_through_mise "$name"; then
    real_tool "$name"
  fi
}

if [ "${1:-}" = tool ]; then
  find_tool_command "$2"
  if [ -n "${HARNESS_QUEUE_HELD:-}" ]; then
    exec_real_tool "$2" "${tool_command[@]}" "${@:3}"
  fi
fi

python=$(hook_python)

if [ "${1:-}" = tool ]; then
  record_handoff "$2" "${tool_command[0]}"
  set -- tool "$2" "${#tool_command[@]}" "${tool_command[@]}" "${@:3}"
fi

exec "$python" "$bin_dir/../hooks/work_queue.py" "$@"
