#!/usr/bin/env bash

set -euo pipefail

bin_dir=$(cd "$(dirname "$0")" && pwd -P)
. "$bin_dir/lib/real_tool.sh"
. "$bin_dir/lib/hook_python.sh"
REAL_TOOL_PATH=$tool_search_path

find_tool_command() {
  local name=$1 tool
  if tool=$(real_tool "$name" 2>/dev/null); then
    tool_command=("$tool")
  elif ! run_through_mise "$name"; then
    real_tool "$name"
  fi
}

if [ "${1:-}" = tool ]; then
  find_tool_command "$2"
  if [ -n "${HARNESS_QUEUE_HELD:-}" ]; then
    exec_real_tool "$2" "${tool_command[@]}" "${@:3}"
  fi
  queued_tool=("${tool_command[@]}")
fi

find_hook_python

if [ "${1:-}" = tool ]; then
  record_handoff "$2" "${queued_tool[0]}"
  set -- tool "$2" "${#queued_tool[@]}" "${queued_tool[@]}" "${@:3}"
fi

exec "$python" "$bin_dir/../hooks/work_queue.py" "$@"
