#!/usr/bin/env bash

set -euo pipefail

bin_dir=$(cd "$(dirname "$0")" && pwd -P)
. "$bin_dir/lib/real_tool.sh"
mise_shims="${MISE_DATA_DIR:-${XDG_DATA_HOME:-$HOME/.local/share}/mise}/shims"
REAL_TOOL_PATH="$PATH:$HOME/.local/bin:$mise_shims"

find_tool_command() {
  local name=$1 tool mise
  if tool=$(real_tool "$name" 2>/dev/null); then
    tool_command=("$tool")
  elif mise=$(real_tool mise 2>/dev/null); then
    tool_command=("$mise" --quiet x "$name" -- "$name")
  else
    real_tool "$name"
  fi
}

find_tool_command uv
uv_command=("${tool_command[@]}")

if [ "${1:-}" = tool ]; then
  find_tool_command "$2"
  if [ -n "${HARNESS_QUEUE_HELD:-}" ]; then
    exec_real_tool "$2" "${tool_command[@]}" "${@:3}"
  fi
  record_handoff "$2" "${tool_command[0]}"
  set -- tool "$2" "${#tool_command[@]}" "${tool_command[@]}" "${@:3}"
fi

run_uv_outside_projects() {
  (cd / && "${uv_command[@]}" "$@")
}

find_python() {
  run_uv_outside_projects python find --no-config --system '>=3.13'
}

if ! python=$(find_python 2>/dev/null); then
  run_uv_outside_projects python install --no-bin 3.13 >&2
  python=$(find_python)
fi
exec "$python" "$bin_dir/../hooks/work_queue.py" "$@"
