#!/usr/bin/env bash

set -euo pipefail

bin_dir=$(cd "$(dirname "$0")" && pwd -P)
. "$bin_dir/lib/real_tool.sh"
REAL_TOOL_PATH="$PATH:$HOME/.local/bin"

if [ "${1:-}" = tool ]; then
  real=$(real_tool "$2")
  if [ -n "${HARNESS_QUEUE_HELD:-}" ]; then
    exec_real_tool "$2" "$real" "${@:3}"
  fi
  set -- tool "$real" "${@:3}"
fi

uv=$(real_tool uv)

find_python() {
  "$uv" python find --no-config --system '>=3.13'
}

if ! python=$(find_python 2>/dev/null); then
  "$uv" --directory / python install --no-bin 3.13 >&2
  python=$(find_python)
fi
exec "$python" "$bin_dir/../hooks/work_queue.py" "$@"
