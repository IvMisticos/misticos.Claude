#!/usr/bin/env bash

set -euo pipefail

bin_dir=$(cd "$(dirname "$0")" && pwd -P)
. "$bin_dir/lib/real_tool.sh"

if [ "${1:-}" = tool ]; then
  real=$(real_tool "$2")
  if [ -n "${HARNESS_QUEUE_HELD:-}" ]; then
    exec "$real" "${@:3}"
  fi
  set -- tool "$real" "${@:3}"
fi

uv=$(real_tool uv)
python=$("$uv" python find --system '>=3.11')
exec "$python" "$bin_dir/../hooks/work_queue.py" "$@"
