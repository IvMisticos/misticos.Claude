#!/usr/bin/env bash

set -euo pipefail

bin_dir=$(cd "$(dirname "$0")" && pwd -P)

is_queue_bin_dir() {
  [ -f "$1/../hooks/work_queue.py" ]
}

first_real() {
  local name=$1 dir
  local -a dirs
  IFS=: read -ra dirs <<< "$PATH:$HOME/.local/bin"
  for dir in "${dirs[@]}"; do
    if [ -f "$dir/$name" ] && [ -x "$dir/$name" ] && ! is_queue_bin_dir "$dir"; then
      printf '%s\n' "$dir/$name"
      return 0
    fi
  done
  echo "queue: $name is not installed" >&2
  return 127
}

if [ "${1:-}" = tool ]; then
  real=$(first_real "$2")
  if [ -n "${HARNESS_QUEUE_HELD:-}" ]; then
    exec "$real" "${@:3}"
  fi
  set -- tool "$real" "${@:3}"
fi

uv=$(first_real uv)
python=$("$uv" python find --system '>=3.11')
exec "$python" "$bin_dir/../hooks/work_queue.py" "$@"
