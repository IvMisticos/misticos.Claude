{
  "version": 1,
  "hooks": {
    "sessionStart": [
      {
        "command": "\"${CURSOR_PLUGIN_ROOT}/hooks/run.sh\" reminder.py 1 4 --harness cursor"
      },
      {
        "command": "\"${CURSOR_PLUGIN_ROOT}/hooks/run.sh\" reminder.py 2 4 --harness cursor"
      },
      {
        "command": "\"${CURSOR_PLUGIN_ROOT}/hooks/run.sh\" reminder.py 3 4 --harness cursor"
      },
      {
        "command": "\"${CURSOR_PLUGIN_ROOT}/hooks/run.sh\" reminder.py 4 4 --harness cursor"
      }
    ],
    "postToolUse": [
      {
        "command": "\"${CURSOR_PLUGIN_ROOT}/hooks/run.sh\" reminder.py 1 4 --harness cursor"
      },
      {
        "command": "\"${CURSOR_PLUGIN_ROOT}/hooks/run.sh\" reminder.py 2 4 --harness cursor"
      },
      {
        "command": "\"${CURSOR_PLUGIN_ROOT}/hooks/run.sh\" reminder.py 3 4 --harness cursor"
      },
      {
        "command": "\"${CURSOR_PLUGIN_ROOT}/hooks/run.sh\" reminder.py 4 4 --harness cursor"
      },
      {
        "command": "\"${CURSOR_PLUGIN_ROOT}/hooks/run.sh\" disk_space.py --harness cursor"
      },
      {
        "command": "\"${CURSOR_PLUGIN_ROOT}/hooks/run.sh\" reply_nags.py --harness cursor"
      }
    ],
    "postToolUseFailure": [
      {
        "command": "\"${CURSOR_PLUGIN_ROOT}/hooks/run.sh\" disk_space.py --harness cursor"
      }
    ],
    "subagentStart": [
      {
        "command": "\"${CURSOR_PLUGIN_ROOT}/hooks/run.sh\" cursor_model_cap.py"
      }
    ],
    "preToolUse": [
      {
        "matcher": "Shell",
        "command": "\"${CURSOR_PLUGIN_ROOT}/hooks/run.sh\" command_prefix.py --harness cursor"
      }
    ],
    "afterAgentResponse": [
      {
        "command": "\"${CURSOR_PLUGIN_ROOT}/hooks/run.sh\" reply_nags.py --harness cursor"
      }
    ],
    "beforeSubmitPrompt": [
      {
        "command": "\"${CURSOR_PLUGIN_ROOT}/hooks/run.sh\" reply_nags.py --harness cursor"
      }
    ],
    "stop": [
      {
        "command": "\"${CURSOR_PLUGIN_ROOT}/hooks/run.sh\" review_thread_reminder.py --harness cursor"
      }
    ]
  }
}
