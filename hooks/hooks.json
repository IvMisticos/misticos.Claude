{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "*",
        "hooks": [
          {
            "name": "misticos-reminder",
            "type": "command",
            "command": "python3 \"${extensionPath}${/}hooks${/}reminder.py\" 1 1 --rules \"${extensionPath}${/}CLAUDE.md\" --context-from-size"
          }
        ]
      }
    ],
    "BeforeAgent": [
      {
        "matcher": "*",
        "hooks": [
          {
            "name": "misticos-reminder",
            "type": "command",
            "command": "python3 \"${extensionPath}${/}hooks${/}reminder.py\" 1 1 --rules \"${extensionPath}${/}CLAUDE.md\" --context-from-size"
          }
        ]
      }
    ],
    "AfterTool": [
      {
        "matcher": "*",
        "hooks": [
          {
            "name": "misticos-reminder",
            "type": "command",
            "command": "python3 \"${extensionPath}${/}hooks${/}reminder.py\" 1 1 --rules \"${extensionPath}${/}CLAUDE.md\" --context-from-size"
          }
        ]
      }
    ]
  }
}
