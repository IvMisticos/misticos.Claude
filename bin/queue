#!/usr/bin/env bash

set -euo pipefail

bin_dir=$(cd "$(dirname "$0")" && pwd -P)

first_outside_bin_dir() {
  local name=$1 dir
  local -a dirs
  IFS=: read -ra dirs <<< "$PATH:$HOME/.local/bin"
  for dir in "${dirs[@]}"; do
    if [ -f "$dir/$name" ] && [ -x "$dir/$name" ] && ! [ "$dir/$name" -ef "$bin_dir/$name" ]; then
      printf '%s\n' "$dir/$name"
      return 0
    fi
  done
  echo "queue: $name is not installed" >&2
  return 127
}

if [ "${1:-}" = tool ]; then
  real=$(first_outside_bin_dir "$2")
  if [ -n "${MISTICOS_QUEUE_HELD:-}" ]; then
    exec "$real" "${@:3}"
  fi
  set -- tool "$real" "${@:3}"
fi

uv=$(first_outside_bin_dir uv)
exec "$uv" run --script "$bin_dir/../hooks/work_queue.py" "$@"
